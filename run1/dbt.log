    sha256(convert_to(concat_ws('||', coalesce(('LT')::text, '<NULL>'), coalesce((customer_id)::text, '<NULL>')), 'UTF8'))                        as customer_hk,
    sha256(convert_to(concat_ws('||', coalesce((segment)::text, '<NULL>'), coalesce((kyc_status)::text, '<NULL>')), 'UTF8'))          as sat_customer__luyen_tap_hd,
    (((updated_at)::date + time '22:00') at time zone 'Asia/Ho_Chi_Minh')             as ingested_ts,
    (updated_at::timestamp at time zone 'Asia/Ho_Chi_Minh') as event_ts,
    'luyen_tap.customers'::text                        as record_source
from src
  );

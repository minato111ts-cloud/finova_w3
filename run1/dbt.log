  create  table "finova_training"."hv04_mart"."fact_order_dv__dbt_tmp"
  
  
    as
  
  (
    -- Grain: 1 dòng = 1 lệnh. Phiên bản khách tại ngày đặt lệnh lấy qua bridge và PIT của đúng ngày đó
with o as (
    select * from "finova_training"."hv04_atomic"."nhl_order"
),
b as (
    select * from "finova_training"."hv04_atomic"."bridge_customer_account"
),
p as (
    select * from "finova_training"."hv04_atomic"."pit_customer_daily"
)
select
    o.order_id,
    to_char(o.trade_date, 'YYYYMMDD')::int                                       as date_key,
    o.order_ts,
    o.account_hk,
    b.customer_hk,
    case when p.sat_customer__luyen_tap_ingested_ts is null then sha256(convert_to(concat_ws('||', coalesce(('<UNKNOWN>')::text, '<NULL>')), 'UTF8'))
         else sha256(convert_to(concat_ws('||', coalesce((encode(p.customer_hk, 'hex'))::text, '<NULL>'), coalesce((to_char((p.sat_customer__luyen_tap_ingested_ts) at time zone 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US"Z"'))::text, '<NULL>')), 'UTF8'))
    end                                                                  as customer_key,
    o.instrument_hk,
    o.side,
    o.status,
    o.status = 'FILLED'                                                  as is_filled,
    case when o.status = 'FILLED' then (o.quantity * o.price)::numeric(20,2) else 0 end as filled_value
from o
left join b on b.account_hk = o.account_hk and b.as_of_date = o.trade_date
left join p on p.customer_hk = b.customer_hk and p.as_of_date = o.trade_date
  );
  

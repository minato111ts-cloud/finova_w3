  create temporary table "sat_customer__luyen_tap__dbt_tmp091036587879"
  
  
    as
  
  (
    -- Grain: 1 dòng = 1 phiên bản thuộc tính khách, theo thời điểm hệ thống biết (ingested_ts)
with w as (
    select customer_hk, ingested_ts, event_ts, sat_customer__luyen_tap_hd as hash_diff, record_source, segment, kyc_status
    from "finova_training"."hv04_staging"."stg_luyen_tap__customers"
    where ingested_ts > (select coalesce(max(ingested_ts), '-infinity'::timestamptz) from "finova_training"."hv04_atomic"."sat_customer__luyen_tap") and ingested_ts <= 'infinity'::timestamptz and customer_hk is not null
),
v as (   -- bỏ dòng trùng nguyên nội dung cùng thời điểm
    select distinct on (customer_hk, ingested_ts, hash_diff) *
    from w
    order by customer_hk, ingested_ts, hash_diff, event_ts
),
cur as ( -- phiên bản mới nhất đã có trong vault của các khóa trong cửa sổ
    select distinct on (t.customer_hk) t.customer_hk, t.hash_diff
    from "finova_training"."hv04_atomic"."sat_customer__luyen_tap" t
    where t.customer_hk in (select customer_hk from v)
    order by t.customer_hk, t.ingested_ts desc
),
seq as (
    select v.*, lag(v.hash_diff) over (partition by v.customer_hk order by v.ingested_ts) as prev_hd
    from v
)
select seq.customer_hk, seq.ingested_ts, seq.event_ts, seq.hash_diff, seq.record_source, seq.segment, seq.kyc_status
from seq
left join cur on cur.customer_hk = seq.customer_hk
where seq.hash_diff is distinct from coalesce(seq.prev_hd, cur.hash_diff)
  );
  
  

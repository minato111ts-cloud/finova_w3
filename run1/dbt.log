  create  table "finova_training"."hv04_mart"."fact_cash_txn__dbt_tmp"
  
  
    as
  
  (
    -- Grain: 1 dòng = 1 giao dịch tiền (fact giao dịch)
-- Chiều tiền lấy từ seed txn_type (cấu hình), không ghi cứng trong SQL
with t as (
    select * from "finova_training"."hv04_staging"."stg_luyen_tap__cash_txn"
),
a as (
    select * from "finova_training"."hv04_mart"."dim_account" where account_id <> '<UNKNOWN>'
),
b as (
    select * from "finova_training"."hv04_mart"."dim_branch" where branch_code <> '<UNKNOWN>'
)
select
    t.txn_id,
    to_char(t.txn_date, 'YYYYMMDD')::int                       as date_key,
    t.txn_ts,
    coalesce(a.account_key, sha256(convert_to(concat_ws('||', coalesce(('<UNKNOWN>')::text, '<NULL>')), 'UTF8')))       as account_key,
    coalesce(b.branch_key,  sha256(convert_to(concat_ws('||', coalesce(('<UNKNOWN>')::text, '<NULL>')), 'UTF8')))       as branch_key,
    a.customer_id,
    t.account_id                                       as source_account_id,   -- giữ để truy vết dòng mồ côi
    t.txn_type,
    tt.txn_group,
    tt.direction,
    t.amount,
    (tt.direction * t.amount)::numeric(20,2)           as signed_amount,
    t.ref_order_id
from t
left join "finova_training"."hv04_ref"."txn_type" tt on tt.txn_type = t.txn_type
left join a on a.account_id = t.account_id
left join b on b.branch_code = a.branch_code
  );
  

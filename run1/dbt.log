  create temporary table "sat_instrument__luyen_tap__dbt_tmp091036421245"
  
  
    as
  
  (
    with w as (
    select instrument_hk, ingested_ts, event_ts, sat_instrument__luyen_tap_hd as hash_diff, record_source, instrument_name, exchange, sector, listing_date
    from "finova_training"."hv04_staging"."stg_luyen_tap__instruments"
    where ingested_ts > (select coalesce(max(ingested_ts), '-infinity'::timestamptz) from "finova_training"."hv04_atomic"."sat_instrument__luyen_tap") and ingested_ts <= 'infinity'::timestamptz and instrument_hk is not null
),
v as (   -- bỏ dòng trùng nguyên nội dung cùng thời điểm
    select distinct on (instrument_hk, ingested_ts, hash_diff) *
    from w
    order by instrument_hk, ingested_ts, hash_diff, event_ts
),
cur as ( -- phiên bản mới nhất đã có trong vault của các khóa trong cửa sổ
    select distinct on (t.instrument_hk) t.instrument_hk, t.hash_diff
    from "finova_training"."hv04_atomic"."sat_instrument__luyen_tap" t
    where t.instrument_hk in (select instrument_hk from v)
    order by t.instrument_hk, t.ingested_ts desc
),
seq as (
    select v.*, lag(v.hash_diff) over (partition by v.instrument_hk order by v.ingested_ts) as prev_hd
    from v
)
select seq.instrument_hk, seq.ingested_ts, seq.event_ts, seq.hash_diff, seq.record_source, seq.instrument_name, seq.exchange, seq.sector, seq.listing_date
from seq
left join cur on cur.instrument_hk = seq.instrument_hk
where seq.hash_diff is distinct from coalesce(seq.prev_hd, cur.hash_diff)
  );
  
  

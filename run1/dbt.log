    sha256(convert_to(concat_ws('||', coalesce((i.instrument_name)::text, '<NULL>'), coalesce((i.exchange)::text, '<NULL>'), coalesce((i.sector)::text, '<NULL>'), coalesce((to_char(i.listing_date, 'YYYY-MM-DD'))::text, '<NULL>')), 'UTF8'))  as sat_instrument__luyen_tap_hd,
    -- bảng tham chiếu nạp một lần trước kỳ dữ liệu
    ((('2026-02-26')::date + time '22:00') at time zone 'Asia/Ho_Chi_Minh')  as ingested_ts,
    (i.listing_date::timestamp at time zone 'Asia/Ho_Chi_Minh')                                          as event_ts,
    'luyen_tap.instruments'::text                                                                      as record_source
from (
    select
        upper(trim(symbol))        as symbol,
        trim(instrument_name)      as instrument_name,
        upper(trim(exchange))      as exchange,
        trim(sector)               as sector,
        listing_date
    from "finova_training"."hv04_source"."instruments"
) i
  );

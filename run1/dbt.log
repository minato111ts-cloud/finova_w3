    -- trade_date lấy theo giờ Việt Nam, ghi tường minh múi giờ (không dùng order_ts::date)
select
    o.*,
    sha256(convert_to(concat_ws('||', coalesce(('LT')::text, '<NULL>'), coalesce((o.order_id)::text, '<NULL>')), 'UTF8'))      as order_hk,
    sha256(convert_to(concat_ws('||', coalesce(('LT')::text, '<NULL>'), coalesce((o.account_id)::text, '<NULL>')), 'UTF8'))    as account_hk,
    sha256(convert_to(concat_ws('||', coalesce(('LT')::text, '<NULL>'), coalesce((o.symbol)::text, '<NULL>')), 'UTF8'))        as instrument_hk,
    (((o.trade_date)::date + time '22:00') at time zone 'Asia/Ho_Chi_Minh')                    as ingested_ts,
    o.order_ts                                                  as event_ts,
    'luyen_tap.orders'::text                                    as record_source
from (
    select
        upper(trim(order_id))                          as order_id,
        upper(trim(account_id))                        as account_id,
        upper(trim(symbol))                            as symbol,
        upper(trim(side))                              as side,
        quantity,
        price::numeric(18,2)                           as price,
        order_ts,
        (order_ts at time zone 'Asia/Ho_Chi_Minh')::date                   as trade_date,
        (order_ts at time zone 'Asia/Ho_Chi_Minh')::time < time '09:00'  as is_pre_session,
        upper(trim(status))                            as status
    from "finova_training"."hv04_source"."orders"
) o
  );
